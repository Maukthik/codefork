# Copy this file to a new file named .env and fill in your values.
# NEVER upload .env to GitHub.

# --- Where the model runs: nebius, openrouter, or ollama ---
PROVIDER=nebius
NEBIUS_API_KEY=paste-your-key-here
NEBIUS_MODEL=paste-a-model-name-from-list_models.py
# NEBIUS_BASE_URL=https://api.tokenfactory.uk-south1.nebius.com/v1

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# --- Optional: a different model per stage (blank = use the main model) ---
# PLANNER_MODEL=
# EXECUTOR_MODEL=
# REFLECTOR_MODEL=

# --- Where the code runs: docker or nebius ---
SANDBOX=docker
# SANDBOX_IMAGE=fork-sandbox
# NEBIUS_PROJECT_ID=
# NEBIUS_SANDBOX_IMAGE=python:3.12-slim
