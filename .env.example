# Copy this file to .env and fill in your values.
# NEVER upload .env to GitHub.

# Provider: ollama | openrouter | nebius
PROVIDER=nebius

# Local Ollama Settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Nebius Token Factory Settings
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_PROJECT_ID=your-nebius-project-id

# Per-stage models
PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
REFLECTOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
EXECUTOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# OpenRouter Settings
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-openrouter-model

# Sandbox: docker | nebius
SANDBOX=docker