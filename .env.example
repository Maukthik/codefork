# Copy this file to .env and fill in your values. Never commit .env.

# --- Models: NVIDIA Nemotron on Nebius Token Factory -------------------------
PROVIDER=nebius
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Default model for any stage without its own setting. Run scripts/list_models.py for exact ids.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Per-stage models: big model to think, small fast model to do the many edit/test turns.
PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
REFLECTOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
EXECUTOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Escalation: executor model per round (aliases nano, super, ultra or full ids).
# Round 1 tries the cheap model; later rounds, which start from the best partial fix, get bigger ones.
EXECUTOR_LADDER=nano,super,ultra

# Reasoning per stage: on | low | off (off/low are faster and cheaper)
EXECUTOR_THINKING=off
# Planning was most of the cost in early runs; low keeps Ultra's plans while cutting its output.
PLANNER_THINKING=low
REFLECTOR_THINKING=low

# End a branch early when it stops making progress
# EXECUTOR_STALL_LIMIT=3   # edits in a row that don't increase passing tests
# EXECUTOR_IDLE_LIMIT=6    # turns in a row without any edit

# --- Sandbox: Nebius Token Factory Sandboxes ---------------------------------
# nebius = every command runs in an isolated cloud sandbox (default)
# local  = runs on this machine; only for the offline tests and trusted demo repos
SANDBOX=nebius
NEBIUS_PROJECT_ID=your-nebius-project-id
SANDBOX_IMAGE=python:3.12-slim
# Show the "local" sandbox option in the Streamlit UI (never set this on a hosted demo)
# ALLOW_LOCAL_SANDBOX=1

# --- Spend control -----------------------------------------------------------
# Stop a run once it has spent this many USD (the UI has its own field).
MAX_USD_PER_RUN=0.50
# Override prices (USD per 1M tokens, [input, output]), matched by substring of the model id.
# PRICES_JSON={"nano": [0.06, 0.24], "super": [0.30, 0.90], "ultra": [1.00, 3.00]}

# --- Other providers (for comparison runs only) ------------------------------
# PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
