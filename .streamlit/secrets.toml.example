# Paste this (filled in) into Streamlit Community Cloud: your app > Settings > Secrets.
# Never commit a real secrets.toml.

HOSTED = "1"                         # public-demo mode
DEMO_ACCESS_CODE = "pick-a-code"     # live runs need it; replays are free for everyone
HOSTED_MAX_USD_PER_RUN = "0.25"      # hard cap per live run
DAILY_BUDGET_USD = "3.00"            # cap for the whole demo per day

PROVIDER = "nebius"
NEBIUS_API_KEY = "your-nebius-api-key"
NEBIUS_PROJECT_ID = "your-nebius-project-id"
NEBIUS_BASE_URL = "https://api.tokenfactory.nebius.com/v1"
NEBIUS_MODEL = "nvidia/nemotron-3-super-120b-a12b"
PLANNER_MODEL = "nvidia/Nemotron-3-Ultra-550b-a55b"
REFLECTOR_MODEL = "nvidia/Nemotron-3-Ultra-550b-a55b"
EXECUTOR_MODEL = "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
EXECUTOR_LADDER = "nano,super,ultra"
EXECUTOR_THINKING = "off"
PLANNER_THINKING = "off"
REFLECTOR_THINKING = "off"
SANDBOX = "nebius"
